APP_ENV=prod
APP_NAME=chat-service
APP_SHUTDOWN_TIMEOUT=15s           # cho request dang chay xu ly xong truoc khi tat

# ---------------- Database ----------------
POSTGRES_USER=chat                 # [BAT BUOC] compose doc bien nay
POSTGRES_PASSWORD=                 # [BAT BUOC] openssl rand -base64 24
POSTGRES_DB=chat                   # [BAT BUOC]

# Chi dung khi chay NGOAI compose (systemd/k8s):
# POSTGRES_DSN=postgres://chat:<pass>@postgres:5432/chat?sslmode=disable

POSTGRES_MAX_OPEN_CONNS=25         # tong ket noi toi da — tang theo so pod
POSTGRES_MAX_IDLE_CONNS=10
POSTGRES_CONN_MAX_LIFETIME=1h
POSTGRES_AUTO_MIGRATE=false        # prod LUON false — dung `make prod-migrate`
POSTGRES_SLOW_QUERY=300ms          # query lau hon nguong nay bi log canh bao
POSTGRES_LOG_SQL=false             # prod de false
POSTGRES_LOG_PRETTY=false          # prod LUON false: ban pretty in ca gia tri tham so (PII)


# ---------------- Redis (fanout WebSocket giua cac instance) ----------------
REDIS_PASSWORD=                    # [BAT BUOC] compose prod dung ${REDIS_PASSWORD:?} — thieu la dung ngay
REDIS_ENABLED=true                 # true khi chay >1 instance (compose prod da bat san)
REDIS_ADDR=redis:6379
REDIS_DB=0
REDIS_EVENT_CHANNEL=chat:events    # doi khi nhieu moi truong dung chung 1 Redis


# ---------------- Auth ----------------
# Khi CMS_ENABLED=true: token nguoi dung do CMS phat (RS256/JWKS), Chat KHONG
# phat token => JWT_SECRET khong bat buoc. Chi can neu van dung token dev HS256.
JWT_SECRET=                        # [BAT BUOC neu AUTH_ALLOW_DEV_TOKEN=true hoac CMS_ENABLED=false]
JWT_ISSUER=                        # de trong = khong kiem claim iss cua token dev
JWT_AUDIENCE=
JWT_LEEWAY=30s                     # bu lech dong ho giua cac may
AUTH_ALLOW_DEV_TOKEN=false         # prod LUON false (`make token` chi dung o local)


# ---------------- HTTP / CORS / WebSocket ----------------
HTTP_ADDR=:8080
HTTP_ALLOW_ORIGINS=https://chat.cong-ty.com   # [NEN DOI] liet ke domain FE, dung "*"
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=30s
HTTP_BODY_LIMIT_MB=25              # anh/tep chi gui URL nen khong can lon

WS_PING_INTERVAL=25s               # phai NHO HON idle timeout cua nginx/Caddy
WS_READ_TIMEOUT=90s                # khong nhan duoc gi trong khoang nay thi dong ket noi
WS_WRITE_TIMEOUT=10s
WS_SEND_BUFFER=256                 # client cham lam day buffer se bi dong de khong keo cham hub
WS_READ_LIMIT_BYTES=1048576        # 1 MiB cho mot frame gui len


# ---------------- gRPC ----------------
GRPC_ADDR=:9090
GRPC_REFLECTION=false              # prod LUON false (khong phoi so do service)
GRPC_MAX_RECV_MB=16


# ---------------- Presence ----------------
# Chong "online mac ket" khi pod bi kill: moi pod lam tuoi last_seen_at cho
# nguoi noi vao chinh no; luc doc, online cu hon TTL thi coi la offline.
# Doi HEARTBEAT thi doi TTL theo, giu ti le it nhat 1:3.
PRESENCE_HEARTBEAT=30s
PRESENCE_TTL=90s


# ---------------- Tich hop CMS (Designer Bot) ----------------
# Bat sau khi `make cms-check` du 6/6. Chi tiet: docs/deploy.md
CMS_ENABLED=true                   # [NEN DOI] false = chay doc lap, khong noi CMS

CHAT_SERVICE_KEY=                  # [BAT BUOC khi CMS_ENABLED=true]
                                   # Khoa dung chung CA 3 huong: Chat ky webhook gui CMS,
                                   # Chat goi Workspace API, Chat kiem request Bot API cua CMS.
                                   # PHAI trung tuyet doi voi gia tri ben CMS.

CMS_BASE_URL=https://cms.cong-ty.com                                   # [NEN DOI] ghep avatarUrl tuong doi
CMS_WORKSPACE_BASE_URL=https://cms.cong-ty.com/api/client/v1/workspace  # [NEN DOI]
CMS_WEBHOOK_URL=https://cms.cong-ty.com/webhook/<webhookPath-cua-bot>   # [BAT BUOC] xin CMS duong dan nay
# CMS_JWKS_URL=                    # de trong = tu suy ra <CMS_WORKSPACE_BASE_URL>/.well-known/jwks.json
CMS_JWT_ISSUER=designer-cms        # phai khop claim iss trong token CMS phat
CMS_JWT_AUDIENCE=abc-workspace     # phai khop claim aud
CMS_JWKS_CACHE_TTL=6h              # gap kid la se tu tai lai truoc khi het han

CMS_SYNC_INTERVAL=60s              # chu ky keo nhom + thanh vien tu CMS
CMS_HTTP_TIMEOUT=10s               # timeout khi Chat goi Workspace API cua CMS
CMS_WEBHOOK_TIMEOUT=5s             # form.submit/card.action goi DONG BO, UI dang cho => dung dat lon
CMS_OUTBOX_INTERVAL=10s            # chu ky day lai event message.created con pending
CMS_OUTBOX_MAX_RETRY=8             # het so lan thi danh dau failed, khong thu nua


# ---------------- Log ----------------
LOG_LEVEL=info                     # debug|info|warn|error — prod dung info (debug co the lo du lieu)
LOG_FORMAT=json                    # json de log aggregator parse duoc
LOG_STDOUT=true                    # prod LUON true: docker/k8s thu gom log tu stdout
LOG_FILE=                          # prod de TRONG: file khong tu rotate, se phinh day dia


# ---------------- Giao dien thu tay ----------------
WEB_DEMO_DIR=                      # prod de TRONG de tat /demo/live.html


# ==============================================================================
#  Chi tiet tung buoc deploy: docs/deploy.md
# ==============================================================================

# ---- API tai lieu ----
# GET /docs/flow tra docs/FLOW.md, can header X-Docs-Key. De trong = tat route.
# Sinh khoa: openssl rand -hex 16
DOCS_API_KEY=

# ---------------- Log trong DB (debug) ----------------
LOG_DB_ENABLED=true
LOG_DB_LEVEL=info                  # prod: info hoac warn (debug lam bang phinh rat nhanh)
LOG_DB_RETENTION=168h              # tu xoa log cu hon 7 ngay
DEBUG_API_KEY=                     # chuoi ngau nhien dai; de trong = khong mo GET /debug/logs
