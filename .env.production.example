# Mau cau hinh chay that. Copy thanh .env tren VPS roi dien, KHONG commit file .env.
# Sinh bi mat:  openssl rand -base64 48

APP_ENV=prod
APP_NAME=chat-service

# ---- database (chi dung trong network docker, khong mo ra ngoai) ----
POSTGRES_USER=chat
POSTGRES_PASSWORD=                 # BAT BUOC doi
POSTGRES_DB=chat
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_AUTO_MIGRATE=false

# ---- auth ----
# Khi tich hop CMS: token do CMS phat (RS256), khong can JWT_SECRET.
JWT_SECRET=                        # BAT BUOC doi neu con dung token HS256
AUTH_ALLOW_DEV_TOKEN=false         # prod BAT BUOC false (service se tu choi khoi dong neu true)

# ---- CORS / WebSocket ----
HTTP_ALLOW_ORIGINS=https://chat.cong-ty.com
WS_PING_INTERVAL=25s
WS_READ_TIMEOUT=90s

# ---- gRPC ----
GRPC_REFLECTION=false

# ---- tich hop CMS (bat khi CMS san sang) ----
CMS_ENABLED=false
CHAT_SERVICE_KEY=                  # khoa dung chung voi CMS
CMS_BASE_URL=https://cms.cong-ty.com
CMS_WORKSPACE_BASE_URL=https://cms.cong-ty.com/api/client/v1/workspace
CMS_WEBHOOK_URL=https://cms.cong-ty.com/webhook/web/designer
CMS_JWT_ISSUER=designer-cms
CMS_JWT_AUDIENCE=abc-workspace
CMS_SYNC_INTERVAL=60s

# ---- module task noi bo (CMS so huu don/task thi de false) ----
TASK_ENGINE_ENABLED=false

# ---- log ----
LOG_LEVEL=info
LOG_FORMAT=json
