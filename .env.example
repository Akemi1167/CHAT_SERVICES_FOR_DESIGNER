# ---- app ----
APP_NAME=chat-service
APP_ENV=local                   # local | dev | staging | prod
APP_SHUTDOWN_TIMEOUT=15s

# ---- http / websocket ----
HTTP_ADDR=:8080
HTTP_ALLOW_ORIGINS=*            # prod: liet ke domain FE, cach nhau bang dau phay
HTTP_BODY_LIMIT_MB=25
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=30s
WS_PING_INTERVAL=25s           # server ping client moi khoang nay
WS_READ_TIMEOUT=90s            # khong nhan duoc pong/frame nao trong khoang nay -> dong ket noi
WS_WRITE_TIMEOUT=10s
WS_READ_LIMIT_BYTES=1048576
WS_SEND_BUFFER=256

# ---- grpc ----
GRPC_ADDR=:9090
GRPC_REFLECTION=true            # prod nen tat
GRPC_MAX_RECV_MB=16

# ---- postgres ----
POSTGRES_DSN=postgres://chat:chat@localhost:5432/chat?sslmode=disable
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=10
POSTGRES_CONN_MAX_LIFETIME=1h
POSTGRES_AUTO_MIGRATE=false     # CHI bat o local; prod dung `make migrate-up`
POSTGRES_LOG_SQL=false          # bat khi can debug query
POSTGRES_SLOW_QUERY=300ms

# ---- redis (fanout WebSocket khi chay nhieu instance) ----
REDIS_ENABLED=false
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_EVENT_CHANNEL=chat:events

# ---- auth (JWT do service auth cua ban phat ra) ----
JWT_SECRET=doi-secret-nay-trong-moi-truong-that
JWT_ISSUER=
JWT_AUDIENCE=
JWT_LEEWAY=30s

# ---- tich hop CMS / Task Engine (docs/10-cms-integration.md) ----
CMS_ENABLED=false
CHAT_SERVICE_KEY=                     # khoa dung chung: ky webhook + Bot API + Workspace API
CMS_BASE_URL=http://localhost:3001
CMS_WORKSPACE_BASE_URL=http://localhost:3001/api/client/v1/workspace
CMS_WEBHOOK_URL=http://localhost:3001/webhook/web/designer
CMS_JWKS_URL=                         # trong = <workspace>/.well-known/jwks.json
CMS_JWKS_CACHE_TTL=6h
CMS_JWT_ISSUER=designer-cms
CMS_JWT_AUDIENCE=abc-workspace
CMS_SYNC_INTERVAL=60s                 # poll GET /workspace/groups
CMS_HTTP_TIMEOUT=10s
CMS_WEBHOOK_TIMEOUT=5s                # form.submit / card.action (dong bo)
CMS_OUTBOX_INTERVAL=10s               # gui lai message.created
CMS_OUTBOX_MAX_RETRY=8

# Token dev HS256 (make token / make ws / Postman). Prod nen tat.
AUTH_ALLOW_DEV_TOKEN=true
# Module task noi bo cua Chat; khi dung CMS thi de false (CMS so huu don/task).
TASK_ENGINE_ENABLED=false

# ---- log ----
LOG_LEVEL=info                  # debug | info | warn | error
LOG_FORMAT=json                 # json | text
